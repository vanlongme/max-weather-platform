        <mxCell id="title" value="Max Weather — AWS POC Architecture (single env: poc, public-subnet topology, EKS 1.30, terraform-aws-modules/eks v21 + Pod Identity)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2520" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="poc_warning" value="POC TRADE-OFF — public subnets only. Worker nodes get public IPs (egress via IGW, no NAT GW, no VPC endpoints). For production: switch to private subnets + NAT GW (or Interface VPC endpoints for ECR/Logs/STS) and flip ingress-nginx Service annotation back to internal. Subnets carry both kubernetes.io/role/elb and kubernetes.io/role/internal-elb tags so the prod overlay can flip without re-tagging." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#FFF4CE;strokeColor=#D79B00;fontColor=#7A4A00;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2520" height="60" as="geometry"/>
        </mxCell>

