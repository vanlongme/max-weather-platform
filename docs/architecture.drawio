        <mxCell id="e10" value="10. ship pod logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#E7157B;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#E7157B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="addons" target="cw">
