        <mxCell id="e1" value="1. HTTPS GET /weather (Bearer JWT)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F6FEB;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1F6FEB;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="client" target="apigw">
