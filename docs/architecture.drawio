<mxfile host="app.diagrams.net" modified="2026-05-10T00:00:00.000Z" agent="sisyphus" version="24.0.0">
  <diagram id="max-weather-arch" name="Max Weather AWS Architecture (POC)">
    <mxGraphModel dx="2400" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1750" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Max Weather — AWS POC Architecture (single env: poc, public-subnet topology)" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="poc_warning" value="POC TRADE-OFF — public subnets only. Worker nodes have public IPs (egress via IGW, no NAT GW, no VPC endpoints). For production: switch to private subnets + NAT GW (or Interface VPC endpoints for ECR/Logs/STS) and flip ingress-nginx Service annotation back to internal. Subnets carry both kubernetes.io/role/elb and kubernetes.io/role/internal-elb tags so the prod overlay can flip without re-tagging." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fillColor=#FFF4CE;strokeColor=#D79B00;fontColor=#7A4A00;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="client" value="Client&#10;(Postman / curl)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="cognito" value="Amazon Cognito&#10;User Pool&#10;(client_credentials, scope: weather-api/read)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD344C;strokeColor=#7B0000;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="170" width="220" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="apigw" value="Amazon API Gateway (HTTP API)&#10;Stage: $default • VPC Link → NLB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C4FFF;strokeColor=#3B1F7A;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="170" width="380" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="authorizer" value="Lambda Authorizer&#10;(REQUEST type, validates Cognito JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#7A4A00;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="170" width="240" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="vpc" value="AWS VPC — 10.20.0.0/16 (us-east-1, 3 AZs) — POC: PUBLIC SUBNETS ONLY" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#E6D9FF;strokeColor=#8C4FFF;fontColor=#3B1F7A;fontSize=14;fontStyle=1;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="1500" height="940" as="geometry"/>
        </mxCell>

        <mxCell id="igw" value="Internet Gateway&#10;(default route 0.0.0.0/0 for all public subnets — no NAT GW)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C4FFF;strokeColor=#3B1F7A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="vpc">
          <mxGeometry x="20" y="50" width="1460" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="pub" value="Public Subnets — 3 AZs (10.20.1.0/24, 10.20.2.0/24, 10.20.3.0/24) — tags: kubernetes.io/role/elb=1, kubernetes.io/role/internal-elb=1, kubernetes.io/cluster/max-weather=shared, karpenter.sh/discovery=max-weather" style="swimlane;startSize=44;html=1;whiteSpace=wrap;fillColor=#F4ECFF;strokeColor=#8C4FFF;fontColor=#3B1F7A;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="vpc">
          <mxGeometry x="20" y="130" width="1460" height="780" as="geometry"/>
        </mxCell>

        <mxCell id="nlb" value="NLB&#10;(Network Load Balancer)&#10;internet-facing, created by AWS LB Controller via NGINX Ingress Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C4FFF;strokeColor=#3B1F7A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="pub">
          <mxGeometry x="40" y="60" width="320" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="jenkins" value="Jenkins EC2 (t3.medium)&#10;public IP + Elastic IP&#10;SG: SSH/HTTPS IP-restricted to allowed_cidrs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#7A4A00;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="pub">
          <mxGeometry x="900" y="60" width="320" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="eks" value="Amazon EKS Cluster (max-weather, v1.30) — control plane (managed; public endpoint locked to allowed_cidrs)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=#FFE9D1;strokeColor=#FF9900;fontColor=#7A4A00;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="pub">
          <mxGeometry x="20" y="220" width="1420" height="540" as="geometry"/>
        </mxCell>

        <mxCell id="nodegroup" value="Managed Node Group: general (label role=general)&#10;t3.medium, ON_DEMAND, AL2023, 2–10 nodes (Cluster Autoscaler) — workers run in PUBLIC subnets, public IPs assigned&#10;Hosts kube-system, ingress-nginx, and the Karpenter controller pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC99;strokeColor=#7A4A00;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="eks">
          <mxGeometry x="20" y="50" width="680" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="karpnodes" value="Karpenter NodePool: default&#10;Provisions on-demand nodes via EC2NodeClass (subnet/SG selectors: karpenter.sh/discovery=max-weather)&#10;Taint: karpenter.sh/provisioned=true:NoSchedule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC99;strokeColor=#7A4A00;fontColor=#000000;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="eks">
          <mxGeometry x="720" y="50" width="680" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="ns_staging" value="Namespace: weather-staging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9900;fontColor=#7A4A00;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="eks">
          <mxGeometry x="20" y="170" width="680" height="350" as="geometry"/>
        </mxCell>

        <mxCell id="nginx" value="NGINX Ingress Controller&#10;(Helm 4.11.3, Service type=LoadBalancer → internet-facing NLB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="ns_staging">
          <mxGeometry x="20" y="40" width="640" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="svc_s" value="Service: weather-api&#10;(ClusterIP, port 80 → 8080)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="ns_staging">
          <mxGeometry x="20" y="120" width="640" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="deploy_s" value="Deployment: weather-api (Node.js Express)&#10;Pods (replicas via HPA 2–10) — calls Open-Meteo via IGW egress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;" vertex="1" parent="ns_staging">
          <mxGeometry x="20" y="200" width="400" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="hpa_s" value="HPA&#10;target CPU 70%&#10;min 2 / max 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;" vertex="1" parent="ns_staging">
          <mxGeometry x="440" y="200" width="220" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="ns_prod" value="Namespace: weather-prod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9900;fontColor=#7A4A00;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="eks">
          <mxGeometry x="720" y="170" width="680" height="350" as="geometry"/>
        </mxCell>

        <mxCell id="nginx_p_note" value="Same NGINX Ingress Controller serves both namespaces&#10;(routes by host/path)" style="text;html=1;align=center;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="ns_prod">
          <mxGeometry x="20" y="40" width="640" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="svc_p" value="Service: weather-api&#10;(ClusterIP, port 80 → 8080)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="ns_prod">
          <mxGeometry x="20" y="120" width="640" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="deploy_p" value="Deployment: weather-api (Node.js Express)&#10;Pods (replicas via HPA 3–10) — calls Open-Meteo via IGW egress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;" vertex="1" parent="ns_prod">
          <mxGeometry x="20" y="200" width="400" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="hpa_p" value="HPA&#10;target CPU 70%&#10;min 3 / max 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;" vertex="1" parent="ns_prod">
          <mxGeometry x="440" y="200" width="220" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="ext_services" value="AWS Managed Services (regional)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#7A4A00;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1580" y="290" width="780" height="940" as="geometry"/>
        </mxCell>

        <mxCell id="ecr" value="Amazon ECR&#10;Repos: max-weather-api, max-weather-lambda-authorizer&#10;Scan-on-push, lifecycle: keep 10 tagged, expire untagged > 7d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#7A4A00;fontSize=12;fontStyle=1;" vertex="1" parent="ext_services">
          <mxGeometry x="20" y="50" width="740" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="cw" value="Amazon CloudWatch&#10;Log Groups: /aws/eks/max-weather/{cluster,application,host}, /aws/lambda/max-weather-authorizer, /aws/apigateway/max-weather-api&#10;Container Insights metrics drive HPA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#7A4A00;fontSize=12;fontStyle=1;" vertex="1" parent="ext_services">
          <mxGeometry x="20" y="150" width="740" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="sm" value="AWS Secrets Manager&#10;/max-weather/cognito/client-secret, /max-weather/app/config&#10;Mounted into pods via External Secrets Operator (IRSA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD344C;strokeColor=#7B0000;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="ext_services">
          <mxGeometry x="20" y="270" width="740" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="iam" value="IAM (IRSA roles)&#10;cluster-autoscaler, fluent-bit, aws-lb-controller, external-secrets, karpenter-controller, karpenter-node&#10;Jenkins EC2 instance profile (ECR push, EKS describe, Lambda deploy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=#1B5524;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="ext_services">
          <mxGeometry x="20" y="370" width="740" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="sqs" value="Karpenter SQS queue + EventBridge rules&#10;(EC2 spot interruption / health events → Karpenter controller drains nodes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD344C;strokeColor=#7B0000;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="ext_services">
          <mxGeometry x="20" y="490" width="740" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="openmeteo" value="Open-Meteo API (3rd party, public Internet)&#10;Pods reach it via Internet Gateway (no NAT GW in POC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="ext_services">
          <mxGeometry x="20" y="610" width="740" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="cicd_box" value="CI/CD: Jenkins Declarative Pipeline (Jenkinsfile)&#10;Stages: checkout → unit tests → docker build → ECR push → kubectl apply (kustomize) → smoke tests&#10;Triggered manually from Jenkins UI; ECR push uses IRSA via instance profile" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;" vertex="1" parent="ext_services">
          <mxGeometry x="20" y="730" width="740" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="state_backend" value="Terraform Remote State&#10;S3 bucket (versioned, encrypted) + DynamoDB lock table&#10;Created by infra/bootstrap/, consumed by infra/envs/poc/backend.tf (key: envs/poc/terraform.tfstate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=#1B5524;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="ext_services">
          <mxGeometry x="20" y="850" width="740" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="e_client_cognito" value="1. POST /oauth2/token (client_credentials)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" source="client" target="cognito" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_client_apigw" value="2. GET /weather (Bearer JWT)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" source="client" target="apigw" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_apigw_auth" value="3. invoke authorizer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" source="apigw" target="authorizer" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_apigw_nlb" value="4. VPC Link → NLB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" source="apigw" target="nlb" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_nlb_nginx" value="5. NLB → ingress-nginx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" source="nlb" target="nginx" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_nginx_svc_s" value="6a. host=staging" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" source="nginx" target="svc_s" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_nginx_svc_p" value="6b. host=prod" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" source="nginx" target="svc_p" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_svc_deploy_s" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="svc_s" target="deploy_s" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_svc_deploy_p" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" source="svc_p" target="deploy_p" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_hpa_deploy_s" value="scales" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=11;" edge="1" source="hpa_s" target="deploy_s" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_hpa_deploy_p" value="scales" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;fontSize=11;" edge="1" source="hpa_p" target="deploy_p" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_deploy_openmeteo_s" value="7. fetch forecast (via IGW)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;dashed=1;" edge="1" source="deploy_s" target="openmeteo" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_auth_cognito" value="JWKS fetch (cached)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;dashed=1;" edge="1" source="authorizer" target="cognito" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_jenkins_ecr" value="docker push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" source="jenkins" target="ecr" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_jenkins_eks" value="kubectl apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;dashed=1;" edge="1" source="jenkins" target="eks" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_node_ecr" value="image pull (via IGW)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;dashed=1;" edge="1" source="nodegroup" target="ecr" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_pods_cw" value="logs (Fluent Bit)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;dashed=1;" edge="1" source="deploy_s" target="cw" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_pods_sm" value="External Secrets sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;dashed=1;" edge="1" source="deploy_p" target="sm" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_karp_sqs" value="EC2 interrupt events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;dashed=1;" edge="1" source="karpnodes" target="sqs" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="Legend&#10;─── Synchronous request flow (numbered 1-7)&#10;- - - Asynchronous / out-of-band traffic&#10;Yellow callout = POC trade-off vs production&#10;Single env: infra/envs/poc/ — hosts both weather-staging and weather-prod namespaces in one EKS cluster" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="1260" width="2320" height="80" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
