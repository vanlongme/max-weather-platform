        <mxCell id="iam" value="AWS IAM&#10;IRSA roles:&#10;• fluent-bit • cluster-autoscaler&#10;• aws-lb-controller • external-secrets&#10;Plus: Jenkins instance role, Lambda exec role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD344C;strokeColor=#7B0000;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="aws_svcs">
