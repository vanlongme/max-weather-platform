        <mxCell id="e2" value="2. invoke (REQUEST authorizer)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F6FEB;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1F6FEB;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="apigw" target="authorizer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="3. fetch JWKS, verify JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F6FEB;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1F6FEB;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="authorizer" target="cognito">
