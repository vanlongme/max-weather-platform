          <mxGeometry x="400" y="50" width="360" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="secrets" value="AWS Secrets Manager&#10;• cognito client_secret&#10;(synced into pods via External Secrets Operator)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD344C;strokeColor=#7B0000;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="aws_svcs">
