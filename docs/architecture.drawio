      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Max Weather — AWS Production Architecture (HA, Auto-scale, OAuth2, CI/CD)" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="client" value="Client&#10;(Postman / curl)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="cognito" value="Amazon Cognito&#10;User Pool&#10;(client_credentials, scope: weather-api/read)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD344C;strokeColor=#7B0000;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="110" width="220" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="apigw" value="Amazon API Gateway (HTTP API)&#10;Stage: $default • VPC Link → NLB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C4FFF;strokeColor=#3B1F7A;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="110" width="380" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="authorizer" value="Lambda Authorizer&#10;(REQUEST type, validates Cognito JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#7A4A00;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="980" y="110" width="240" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="vpc" value="AWS VPC — 10.20.0.0/16 (us-east-1, 3 AZs)" style="swimlane;startSize=34;html=1;whiteSpace=wrap;fillColor=#E6D9FF;strokeColor=#8C4FFF;fontColor=#3B1F7A;fontSize=14;fontStyle=1;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="1500" height="900" as="geometry"/>
        </mxCell>

        <mxCell id="pub" value="Public Subnets (3 AZs — 10.20.0.0/24, 10.20.1.0/24, 10.20.2.0/24)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;fillColor=#F4ECFF;strokeColor=#8C4FFF;fontColor=#3B1F7A;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="vpc">
          <mxGeometry x="20" y="50" width="1460" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="nlb" value="NLB&#10;(Network Load Balancer)&#10;internet-facing, created by AWS LB Controller via NGINX Ingress Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C4FFF;strokeColor=#3B1F7A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="pub">
          <mxGeometry x="40" y="50" width="320" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="nat" value="NAT Gateway&#10;(1x, AZ-a, EIP)&#10;egress for private subnets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C4FFF;strokeColor=#3B1F7A;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="pub">
          <mxGeometry x="500" y="50" width="280" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="jenkins" value="Jenkins EC2 (t3.medium)&#10;in public subnet, EIP&#10;SG: SSH/HTTPS IP-restricted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FF9900;strokeColor=#7A4A00;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="pub">
          <mxGeometry x="900" y="50" width="320" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="priv" value="Private Subnets (3 AZs — 10.20.10.0/24, 10.20.11.0/24, 10.20.12.0/24)" style="swimlane;startSize=28;html=1;whiteSpace=wrap;fillColor=#F4ECFF;strokeColor=#8C4FFF;fontColor=#3B1F7A;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="vpc">
          <mxGeometry x="20" y="270" width="1460" height="610" as="geometry"/>
        </mxCell>

        <mxCell id="eks" value="Amazon EKS Cluster (max-weather, v1.30) — control plane (managed, IP-restricted public endpoint)" style="swimlane;startSize=30;html=1;whiteSpace=wrap;fillColor=#FFE9D1;strokeColor=#FF9900;fontColor=#7A4A00;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="priv">
          <mxGeometry x="20" y="40" width="1420" height="550" as="geometry"/>
        </mxCell>

        <mxCell id="nodegroup" value="Managed Node Group&#10;(t3.medium, ON_DEMAND, AL2023, 2–10 nodes via Cluster Autoscaler)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCC99;strokeColor=#7A4A00;fontColor=#000000;fontSize=12;fontStyle=1;" vertex="1" parent="eks">
          <mxGeometry x="20" y="50" width="380" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="ns" value="Namespace: weather-staging (and weather-prod)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9900;fontColor=#7A4A00;fontSize=12;fontStyle=1;dashed=1;" vertex="1" parent="eks">
          <mxGeometry x="20" y="150" width="900" height="380" as="geometry"/>
        </mxCell>

        <mxCell id="nginx" value="NGINX Ingress Controller&#10;(Helm 4.11.3, Service type=LoadBalancer → NLB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="ns">
          <mxGeometry x="20" y="40" width="360" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="svc" value="Service: weather-api&#10;(ClusterIP, port 80 → 8080)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="ns">
          <mxGeometry x="420" y="40" width="320" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="deploy" value="Deployment: weather-api&#10;Pods (replicas via HPA 2–10)&#10;requests: 100m/128Mi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;" vertex="1" parent="ns">
          <mxGeometry x="20" y="160" width="360" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="hpa" value="HPA&#10;target CPU 70%&#10;min 2 / max 10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontStyle=1;" vertex="1" parent="ns">
          <mxGeometry x="420" y="160" width="320" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="podnote" value="weather-api pod calls Open-Meteo over NAT GW egress" style="text;html=1;align=center;fontSize=11;fontStyle=2;fontColor=#666666;" vertex="1" parent="ns">
          <mxGeometry x="20" y="290" width="720" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="addons" value="Cluster Add-ons (kube-system)&#10;• Cluster Autoscaler (IRSA)&#10;• Fluent Bit → CloudWatch (IRSA)&#10;• AWS Load Balancer Controller (IRSA)&#10;• External Secrets Operator (IRSA)&#10;• metrics-server" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9900;fontColor=#7A4A00;fontSize=12;fontStyle=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="eks">
