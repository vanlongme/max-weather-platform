        <mxCell id="e4" value="4. forward via VPC Link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F6FEB;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1F6FEB;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="apigw" target="nlb">
