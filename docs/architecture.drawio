        <mxCell id="e5" value="5. TCP/80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F6FEB;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1F6FEB;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="nlb" target="nginx">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="6. route → Service → Pod" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F6FEB;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1F6FEB;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="nginx" target="svc">
