        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;" value="Legend&#xa;- Dashed red arrow: operator path via public allowlist&#xa;- Solid green arrow: private path via private endpoint / VPCE&#xa;- Dashed black arrow: control / async (provision, image pull)&#xa;- Solid black arrow: in-band traffic&#xa;- Public Subnet AZ-a hosts Jenkins MNG + single NAT Gateway + IGW&#xa;- Private Subnets host EKS control-plane ENIs, Karpenter nodes,&#xa;  weather-api pods, internal NLB ENIs, VPC Link ENIs,&#xa;  16x Interface VPC Endpoint ENIs + S3 Gateway VPC Endpoint" vertex="1">
          <mxGeometry height="200" width="540" x="2050" y="1500" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
