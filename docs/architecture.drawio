        <mxCell id="ecr" value="Amazon ECR&#10;Repositories:&#10;• weather-api&#10;• lambda-authorizer&#10;Image scanning on push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3F8624;strokeColor=#1F4012;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="aws_svcs">
