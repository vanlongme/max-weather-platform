        <mxCell id="e7" value="7. HTTPS GET (egress via NAT GW)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F6FEB;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#1F6FEB;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="deploy" target="openmeteo">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="8. docker push (image)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D9822B;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7A4A00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="jenkins" target="ecr">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="9. kubectl apply / helm upgrade" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D9822B;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#7A4A00;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="jenkins" target="eks">
          <mxGeometry relative="1" as="geometry"/>
