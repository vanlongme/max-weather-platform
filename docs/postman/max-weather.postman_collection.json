{
  "info": {
    "_postman_id": "max-weather-api-collection",
    "name": "Max Weather API",
    "description": "Max Weather API — end-to-end tests including OAuth2 authorization via Cognito client_credentials flow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expiry = pm.collectionVariables.get('token_expiry');",
          "const now = Date.now();",
          "if (expiry && now < parseInt(expiry)) return;",
          "",
          "const tokenUrl = pm.collectionVariables.get('cognito_token_endpoint');",
          "const clientId = pm.collectionVariables.get('cognito_client_id');",
          "const clientSecret = pm.collectionVariables.get('cognito_client_secret');",
          "const scope = pm.collectionVariables.get('cognito_scope') || 'weather-api/read';",
          "",
          "const credentials = btoa(clientId + ':' + clientSecret);",
          "",
          "pm.sendRequest({",
          "  url: tokenUrl,",
          "  method: 'POST',",
          "  header: {",
          "    'Content-Type': 'application/x-www-form-urlencoded',",
          "    'Authorization': 'Basic ' + credentials",
          "  },",
          "  body: {",
          "    mode: 'urlencoded',",
          "    urlencoded: [",
          "      { key: 'grant_type', value: 'client_credentials' },",
          "      { key: 'scope', value: scope }",
          "    ]",
          "  }",
          "}, function (err, res) {",
          "  if (err) { console.error(err); return; }",
          "  const body = res.json();",
          "  if (body.access_token) {",
          "    pm.collectionVariables.set('access_token', body.access_token);",
          "    pm.collectionVariables.set('token_expiry', Date.now() + 270000);",
          "  }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Weather",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{invoke_url}}/healthz",
              "host": ["{{invoke_url}}"],
              "path": ["healthz"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body has status ok', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Weather Ho Chi Minh City",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{invoke_url}}/weather?latitude=10.78&longitude=106.70",
              "host": ["{{invoke_url}}"],
              "path": ["weather"],
              "query": [
                { "key": "latitude", "value": "10.78" },
                { "key": "longitude", "value": "106.70" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has current_weather', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('current_weather');",
                  "  pm.expect(body.current_weather.temperature).to.be.a('number');",
                  "});",
                  "pm.test('Has _meta source', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body._meta.source).to.eql('open-meteo');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Weather Hanoi",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{invoke_url}}/weather?latitude=21.03&longitude=105.85",
              "host": ["{{invoke_url}}"],
              "path": ["weather"],
              "query": [
                { "key": "latitude", "value": "21.03" },
                { "key": "longitude", "value": "105.85" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has current_weather', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('current_weather');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Weather Missing Params (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{invoke_url}}/weather",
              "host": ["{{invoke_url}}"],
              "path": ["weather"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Has error message', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('error');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth Negative",
      "item": [
        {
          "name": "No Token (401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{invoke_url}}/weather?latitude=10.78&longitude=106.70",
              "host": ["{{invoke_url}}"],
              "path": ["weather"],
              "query": [
                { "key": "latitude", "value": "10.78" },
                { "key": "longitude", "value": "106.70" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 without token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid Token (401)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "invalid.token.here", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{invoke_url}}/weather?latitude=10.78&longitude=106.70",
              "host": ["{{invoke_url}}"],
              "path": ["weather"],
              "query": [
                { "key": "latitude", "value": "10.78" },
                { "key": "longitude", "value": "106.70" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401 with invalid token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "invoke_url", "value": "https://PLACEHOLDER.execute-api.us-east-1.amazonaws.com/prod", "type": "string" },
    { "key": "cognito_token_endpoint", "value": "https://PLACEHOLDER.auth.us-east-1.amazoncognito.com/oauth2/token", "type": "string" },
    { "key": "cognito_client_id", "value": "PLACEHOLDER", "type": "string" },
    { "key": "cognito_client_secret", "value": "PLACEHOLDER", "type": "secret" },
    { "key": "cognito_scope", "value": "weather-api/read", "type": "string" },
    { "key": "access_token", "value": "", "type": "secret" },
    { "key": "token_expiry", "value": "0", "type": "string" }
  ]
}
