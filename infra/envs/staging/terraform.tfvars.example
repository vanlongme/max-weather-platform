aws_region            = "us-east-1"
cluster_name          = "max-weather"
allowed_cidrs         = ["YOUR_PUBLIC_IP/32"]
cognito_domain_prefix = "max-weather-UNIQUE-SUFFIX"

# Phase-2 apply: set these after the EKS cluster is created
# Retrieve with: terraform output oidc_provider_arn / oidc_provider_url
# oidc_provider_arn = "arn:aws:iam::ACCOUNT_ID:oidc-provider/oidc.eks.us-east-1.amazonaws.com/id/CLUSTER_ID"
# oidc_provider_url = "oidc.eks.us-east-1.amazonaws.com/id/CLUSTER_ID"

# Optional overrides (defaults are suitable for assessment)
# eks_cluster_version  = "1.30"
# node_min_size        = 2
# node_max_size        = 10
# node_desired_size    = 2
# log_retention_days   = 7
