###############################################################################
# Hybrid-private cluster topology: 2-tier VPC (public toolchain + private EKS workloads).
# Hybrid EKS endpoint: private_access=true + public_access=true with operator CIDR allowlist.
# 16 interface VPCEs + S3 gateway for private AWS API access. Single NAT GW in us-east-1a.
###############################################################################
#
# Required variables — copy this file to terraform.tfvars and fill in.
#
# Resource names are built from `master_prefix = "<environment>-<project>"`,
# where `environment` is derived from this composition's directory name
# (e.g. infra/envs/poc -> "poc"). With the defaults below, master_prefix
# evaluates to "poc-max-weather".
###############################################################################

aws_region    = "us-east-1"
project       = "max-weather"
# WARNING: 0.0.0.0/0 is REJECTED by module validation. Replace YOUR_OPERATOR_IP with your actual /32.
allowed_cidrs = ["YOUR_OPERATOR_IP/32"]

# ###############################################################################
# # Optional overrides — uncomment to customize. Defaults preserve the original
# # POC behavior: 1.34 EKS on Bottlerocket, single 'infra' m6i.large managed node
# # group (2/10/2), 7-day log retention, one ECR repo (api), three Secrets Manager
# # secrets, lambda authorizer function, and the five built-in EKS Pod Identity roles.
# #
# # Map-variable semantics: supplying any map(object) variable REPLACES the
# # default map entirely (no merge). Re-declare any built-in entries you want
# # to keep. Names accept the literal placeholders __CLUSTER_NAME__,
# # __AWS_REGION__, __AWS_ACCOUNT_ID__, __AWS_PARTITION__ which the modules
# # substitute at apply time.
# ###############################################################################

# eks_cluster_version = "1.34"
# log_retention_days  = 7

###############################################################################
# Networking — VPC CIDR + AZ / public + private subnet layout
###############################################################################
# vpc_cidr            = "10.20.0.0/16"
# availability_zones  = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs = ["10.20.1.0/24", "10.20.2.0/24", "10.20.3.0/24"]
# private_subnet_cidrs             = ["10.20.11.0/24", "10.20.12.0/24", "10.20.13.0/24"]
# enable_nat_gateway               = true
# enable_vpc_endpoints             = true
# enable_s3_gateway_endpoint       = true
# vpc_endpoint_private_dns_enabled = true
# vpc_interface_endpoints = {
#   "ec2"                  = "ec2"
#   "ecr_api"              = "ecr.api"
#   "ecr_dkr"              = "ecr.dkr"
#   "sts"                  = "sts"
#   "logs"                 = "logs"
#   "eks"                  = "eks"
#   "eks_auth"             = "eks-auth"
#   "ssm"                  = "ssm"
#   "ssmmessages"          = "ssmmessages"
#   "ec2messages"          = "ec2messages"
#   "secretsmanager"       = "secretsmanager"
#   "kms"                  = "kms"
#   "autoscaling"          = "autoscaling"
#   "elasticloadbalancing" = "elasticloadbalancing"
#   "lambda"               = "lambda"
#   "monitoring"           = "monitoring"
# }

###############################################################################
# EKS endpoint posture + control-plane logging (hybrid-private defaults)
###############################################################################
# endpoint_private_access = true
# endpoint_public_access  = true
# enabled_log_types = ["api", "audit", "authenticator", "controllerManager", "scheduler"]

###############################################################################
# EKS cluster add-ons — defaults: CoreDNS, kube-proxy, VPC CNI, Pod Identity Agent
###############################################################################
