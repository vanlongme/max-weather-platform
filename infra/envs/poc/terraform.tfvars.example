###############################################################################
# Legacy IRSA roles (OIDC web-identity). Empty by default — prefer
# pod_identity_roles for new workloads on EKS 1.30+.
###############################################################################
# iam_irsa_roles = {
#   legacy_workload = {
#     namespace       = "legacy"
#     service_account = "worker"
#     policy_json     = "..."
