###############################################################################
# Required variables — copy this file to terraform.tfvars and fill in.
###############################################################################
aws_region            = "us-east-1"
cluster_name          = "max-weather"
allowed_cidrs         = ["YOUR_PUBLIC_IP/32"]
cognito_domain_prefix = "max-weather-UNIQUE-SUFFIX"

###############################################################################
# Optional overrides — uncomment to customize. Defaults preserve the original
# POC behavior: 1.30 EKS, single t3.medium 2/10/2 general node group, 7-day
# log retention, two ECR repos, two Secrets Manager secrets, weather-api
# Cognito client, and the five built-in IRSA roles.
###############################################################################

# eks_cluster_version = "1.30"
# log_retention_days  = 7

###############################################################################
# EKS managed node groups — multiple groups, mixed instance types, taints, etc.
###############################################################################
# eks_managed_node_groups = {
#   general = {
#     instance_types = ["t3.medium"]
#     min_size       = 2
#     max_size       = 10
#     desired_size   = 2
#     labels         = { role = "general" }
#   }
#   spot = {
#     instance_types = ["t3.large", "t3a.large"]
#     capacity_type  = "SPOT"
#     min_size       = 0
#     max_size       = 20
#     desired_size   = 0
#     labels         = { role = "spot" }
#     taints = {
#       spot = { key = "spot", value = "true", effect = "NO_SCHEDULE" }
#     }
#   }
# }

###############################################################################
# CloudWatch log groups — `__CLUSTER_NAME__` is substituted with var.cluster_name
###############################################################################
# log_groups = {
#   eks_application   = { name = "/aws/eks/__CLUSTER_NAME__/application" }
#   eks_control_plane = { name = "/aws/eks/__CLUSTER_NAME__/cluster" }
#   lambda_authorizer = { name = "/aws/lambda/__CLUSTER_NAME__-authorizer" }
#   api_gateway       = { name = "/aws/apigateway/__CLUSTER_NAME__-api" }
#   jenkins           = { name = "/aws/ec2/__CLUSTER_NAME__-jenkins" }
#   my_extra          = { name = "/aws/myapp", retention_days = 14 }
# }

###############################################################################
# ECR repositories — map keyed by full repo name; per-repo overrides optional
###############################################################################
# ecr_repositories = {
#   "max-weather-api"               = {}
#   "max-weather-lambda-authorizer" = { keep_tagged_image_count = 5 }
# }

