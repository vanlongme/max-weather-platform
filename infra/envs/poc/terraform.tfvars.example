#   vpc-cni                = { depends_on_node_group = false }
#   eks-pod-identity-agent = { depends_on_node_group = true }
# }

###############################################################################
# Extra EKS access entries — merged after the operator + jenkins entries the
# eks module creates by default. Use to grant additional principals cluster
# access without modifying the module.
###############################################################################
# eks_access_entries = {
#   readonly = {
