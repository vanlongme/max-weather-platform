# REQUIRED: Name prefix applied to every resource (typically the master_prefix
# from the composition, e.g. 'poc-max-weather').
name = "poc-max-weather"

# Log retention in days.
log_retention_days = 30

# Common tags.
tags = {
  Project     = "max-weather"
  Environment = "poc"
  ManagedBy   = "terraform"
}

# Literal placeholder token in log group names that is substituted with var.name
# at apply time.
cluster_name_placeholder = "__CLUSTER_NAME__"

# Map of CloudWatch log groups to create, keyed by short name.
# Each entry's optional name field overrides the default <var.name>-<key>-logs naming
# and may interpolate var.name via the literal placeholder __CLUSTER_NAME__.
# When name is null the default applies. When retention_days is null,
# var.log_retention_days applies.
#
# Supplying log_groups REPLACES the defaults entirely. To extend defaults,
# re-declare all default entries plus your custom ones.
log_groups = {
  eks_application = {
    name           = "/aws/eks/__CLUSTER_NAME__/application"
    retention_days = null
  }
  eks_control_plane = {
    name           = "/aws/eks/__CLUSTER_NAME__/cluster"
    retention_days = null
  }
  api_gateway = {
    name           = "/aws/apigateway/__CLUSTER_NAME__-api"
    retention_days = null
  }
  jenkins = {
    name           = "/aws/ec2/__CLUSTER_NAME__-jenkins"
    retention_days = null
  }
}
