# REQUIRED: Name prefix applied to every IAM role (typically the master_prefix
# from the composition, e.g. 'poc-max-weather'). Each role is named
# <name>-<per-entry role_name_suffix or map_key><module role_name_suffix>.
# Also substitutes the __CLUSTER_NAME__ placeholder in inline policy JSON.
name = "poc-max-weather"

# REQUIRED: AWS region used for ARN construction in policies (substitutes __AWS_REGION__).
aws_region = "us-east-1"

# REQUIRED: AWS account ID for policy ARN construction (substitutes __AWS_ACCOUNT_ID__).
aws_account_id = "123456789012"

# Common tags to apply to all roles.
tags = {
  Project     = "max-weather"
  Environment = "poc"
  ManagedBy   = "terraform"
}

# Suffix appended to every IAM role name after the per-entry portion.
# Default '-role' makes role names self-describing (e.g. 'poc-max-weather-jenkins-role').
role_name_suffix = "-role"

# Map of AWS service-principal IAM roles (EC2, Lambda, ECS task, etc.).
# Keyed by short name. service_principals lists the AWS service principals
# the role can be assumed by (e.g. ["lambda.amazonaws.com"]).
# policy_json is the inline policy; managed_policy_arns attaches AWS-managed policies.
# Default ships one built-in: lambda_authorizer (Lambda execution role with
# Secrets Manager access scoped to the authorizer JWT secret).
service_roles = {
  lambda_authorizer = {
    service_principals  = ["lambda.amazonaws.com"]
    managed_policy_arns = ["arn:__AWS_PARTITION__:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"]
    policy_json         = <<-EOT
      {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "AllowGetSecret",
            "Effect": "Allow",
            "Action": "secretsmanager:GetSecretValue",
            "Resource": "arn:__AWS_PARTITION__:secretsmanager:__AWS_REGION__:__AWS_ACCOUNT_ID__:secret:__CLUSTER_NAME__-authorizer-jwt-secret-*"
          }
        ]
      }
    EOT
  }
}

# Map of IAM Roles for Service Accounts (OIDC web-identity trust).
# Empty by default. Requires var.oidc_provider_arn + var.oidc_provider_url
# to be non-empty; entries are skipped otherwise.
# Prefer pod_identity_roles for new workloads on EKS 1.30+.
irsa_roles = {}

# Map of EKS Pod Identity roles (pods.eks.amazonaws.com trust).
# When null, the module ships the built-in workload roles:
# jenkins, cluster-autoscaler, fluent-bit, external-secrets, ebs-csi-controller,
# efs-csi-controller. Override (replaces defaults entirely — re-declare any
# built-ins to keep). The module creates roles + inline policies + managed-policy
# attachments; Pod Identity associations are created by the eks module via the
# role_bindings output. policy_json is optional — omit when managed_policy_arns
# alone is sufficient (e.g. EBS/EFS CSI use AWS-managed policies).
pod_identity_roles = null

# ARN of the EKS OIDC provider for IRSA trust relationships.
# Required when irsa_roles is non-empty. Sourced from the eks module.
oidc_provider_arn = ""

# URL of the EKS OIDC provider (without https:// prefix).
# Required when irsa_roles is non-empty. Sourced from the eks module.
oidc_provider_url = ""

# Suffix appended to each role's map key to form the inline aws_iam_role_policy name.
inline_policy_name_suffix = "-policy"

# Literal placeholder token in policy JSON substituted with
# data.aws_partition.current.partition at apply time.
partition_placeholder = "__AWS_PARTITION__"

# Literal placeholder token in policy JSON substituted with var.aws_region at apply time.
region_placeholder = "__AWS_REGION__"

# Literal placeholder token in policy JSON substituted with var.aws_account_id at apply time.
account_id_placeholder = "__AWS_ACCOUNT_ID__"

# Literal placeholder token in policy JSON substituted with var.name at apply time.
# Named for backward compatibility — the substituted value is the resource name
# prefix shared across the deployment.
cluster_name_placeholder = "__CLUSTER_NAME__"

# Effect on the IRSA assume-role policy statement.
irsa_assume_role_effect = "Allow"

# Action on the IRSA assume-role policy statement (the only action used by
# the OIDC web-identity trust).
irsa_assume_role_action = "sts:AssumeRoleWithWebIdentity"

# Principal type on the IRSA assume-role policy statement.
irsa_assume_role_principal_type = "Federated"

# Condition test operator used for both :sub and :aud OIDC claims on the
# IRSA assume-role policy statement.
irsa_assume_role_condition_test = "StringEquals"

# OIDC issuer URL suffix that selects the subject claim in the IRSA
# assume-role condition (appended to var.oidc_provider_url).
irsa_assume_role_sub_suffix = ":sub"

# OIDC issuer URL suffix that selects the audience claim in the IRSA
# assume-role condition (appended to var.oidc_provider_url).
irsa_assume_role_aud_suffix = ":aud"

# Prefix for the OIDC :sub claim value identifying a Kubernetes ServiceAccount.
irsa_assume_role_subject_prefix = "system:serviceaccount:"

# Required value of the OIDC :aud claim for the EKS IRSA trust relationship.
irsa_assume_role_audience = "sts.amazonaws.com"

# Effect on the Pod Identity assume-role policy statement.
pod_identity_assume_role_effect = "Allow"

# Actions on the Pod Identity assume-role policy statement. Pod Identity requires
# both sts:AssumeRole (to assume) and sts:TagSession (to tag the session
# with EKS context).
pod_identity_assume_role_actions = ["sts:AssumeRole", "sts:TagSession"]

# Principal type on the Pod Identity assume-role policy statement.
pod_identity_assume_role_principal_type = "Service"

# Service principal that EKS Pod Identity uses to assume workload roles.
pod_identity_assume_role_principal_service = "pods.eks.amazonaws.com"

# Effect on the service-role assume-role policy statement.
service_role_assume_effect = "Allow"

# Actions on the service-role assume-role policy statement.
service_role_assume_actions = ["sts:AssumeRole"]

# Principal type on the service-role assume-role policy statement.
service_role_assume_principal_type = "Service"
