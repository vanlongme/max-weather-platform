cluster_name = "max-weather"

tags = {
  Project     = "max-weather"
  Environment = "poc"
  ManagedBy   = "terraform"
}

# `secrets` is optional. When omitted, the module's two stock secrets
# (authorizer_jwt_secret + app_config) are provisioned with their defaults.
# Supplying this variable REPLACES the defaults entirely; redeclare the stock
# entries below if you want to keep them.
#
# secrets = {
#   authorizer_jwt_secret = {
#     description             = "HS256 shared secret for the Lambda authorizer (operator-populated)."
#     recovery_window_in_days = 0
#   }
#   app_config = {
#     name          = "/__CLUSTER_NAME__/app/config"
#     description   = "weather-api application runtime configuration."
#     initial_value = "{\"OPEN_METEO_BASE_URL\":\"https://api.open-meteo.com/v1\",\"PORT\":\"3000\"}"
#   }
#   # Example custom secret (caller populates the value out-of-band):
#   # third_party_api_key = {
#   #   name                    = "/__CLUSTER_NAME__/third-party/api-key"
#   #   description             = "API key for ExampleCorp upstream."
#   #   initial_value           = null
#   #   recovery_window_in_days = 30
#   # }
# }
