# Example tfvars for the networking module.
# Copy to terraform.tfvars (or pass via -var-file) when invoking this module standalone.

cluster_name       = "max-weather"
vpc_cidr           = "10.20.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

public_subnet_cidrs = ["10.20.1.0/24", "10.20.2.0/24", "10.20.3.0/24"]

enable_dns_hostnames = true
enable_dns_support   = true

tags = {
  Project     = "max-weather"
  Environment = "poc"
  ManagedBy   = "terraform"
}
