# Copy to terraform.tfvars and fill values before applying
# NOTE: terraform.tfvars is gitignored — never commit real secrets

region             = "ap-southeast-1"
cluster_name       = "max-weather-cluster"
node_instance_type = "t3.medium"
weatherapi_key     = "YOUR_WEATHERAPI_KEY_HERE"
test_user_email    = "testuser@maxweather.io"
# test_user_password is set via: export TF_VAR_test_user_password="TempPassword!23"
